
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  fullName         String
  email            String    @unique
  passwordHash     String
  role             String    @default("Student")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  profile          Profile?
  sentRequests     Request[] @relation("RequestSender")
  receivedRequests Request[] @relation("RequestRecipient")

  @@index([role])
}

model Profile {
  id               String   @id @default(cuid())
  userId           String   @unique
  graduationYear   Int
  jobTitle         String?
  companyId        String?
  industryId       String?
  techStack        String   @default("")
  bio              String   @default("")
  careerGoals      String   @default("")
  pictureBlobName  String?
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company          Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  industry         Industry? @relation(fields: [industryId], references: [id], onDelete: SetNull)

  @@index([graduationYear])
  @@index([companyId])
  @@index([industryId])
}

model Company {
  id        String    @id @default(cuid())
  name      String    @unique
  website   String?
  profiles  Profile[]
}

model Industry {
  id        String    @id @default(cuid())
  name      String    @unique
  profiles  Profile[]
}

model Request {
  id          String   @id @default(cuid())
  studentId   String
  alumniId    String
  message     String
  reply       String?
  status      String   @default("Pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student     User     @relation("RequestSender", fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  alumni      User     @relation("RequestRecipient", fields: [alumniId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([studentId, createdAt])
  @@index([alumniId, status])
}
